      "id": "mexc_spot",
      "name": "MEXC Spot Bot",
      "github_repo": "romaincortese-ui/mexc-bot-v2",
      "railway_service": "mexc-bot-v2",
      "railway_environment": "production",
      "setup_command": ["python", "-m", "pip", "install", "-r", "requirements.txt"],
      "backtest_command": ["python", "-m", "backtest.run_daily_calibration"],
      "backtest_env": {"BACKTEST_ROLLING_DAYS": "30", "BACKTEST_PRINT_FULL_REPORT": "true"},
      "test_command": ["python", "-m", "pytest"],
      "maturity": "mature",
      "compatible_review_redis_key": "mexc_daily_review",
      "overlay_redis_key": "bot_assessor:mexc_spot:overlays",
      "allow_parameter_overlays": true,
      "allowed_overlay_types": ["score_offset", "strategy_block", "symbol_block", "threshold_adjustment"],
      "optimizer_enabled": true,
      "candidate_generator": "mexc_spot_thresholds",
      "optimizer_command": [],
      "optimizer_backtests": [
        {"name": "30d", "command": ["python", "-m", "backtest.run_daily_calibration"], "env": {"BACKTEST_ROLLING_DAYS": "30", "BACKTEST_PRINT_FULL_REPORT": "true"}},
        {"name": "60d", "command": ["python", "-m", "backtest.run_daily_calibration"], "env": {"BACKTEST_ROLLING_DAYS": "60", "BACKTEST_PRINT_FULL_REPORT": "true"}}
      ],
      "optimizer_guardrails": {"require_tests": true, "require_backtests": true, "require_pnl_improvement": true, "require_profit_factor_not_worse": true, "require_return_pct_not_worse": false, "require_win_rate_not_worse": false, "min_trades": 5, "min_candidate_profit_factor": 1.05, "max_trade_count_drop_pct": 0.35, "max_drawdown_worsening": 0.02},
      "allowed_pr_file_patterns": ["mexcbot/config.py", "backtest/config.py", "bot_assessor_candidate_config.json"],
      "auto_merge_enabled": true,
      "auto_merge_allowed_file_patterns": ["mexcbot/config.py", "backtest/config.py", "bot_assessor_candidate_config.json"]
    },
