{
  "github_repo": "romaincortese-ui/bot-assessor",
  "artifact_dir": "artifacts",
  "workdir": "workdir",
  "window_hours": 24,
  "log_lines": 1200,
  "report_labels": ["daily-assessment", "bot-assessor"],
  "bots": [
    {
      "id": "mexc_spot",
      "name": "MEXC Spot Bot",
      "github_repo": "romaincortese-ui/mexc-bot-v2",
      "railway_service": "mexc-bot-v2",
      "railway_environment": "production",
      "backtest_command": ["python", "-m", "backtest.run_daily_calibration"],
      "backtest_env": {"BACKTEST_ROLLING_DAYS": "30", "BACKTEST_PRINT_FULL_REPORT": "false"},
      "maturity": "mature",
      "compatible_review_redis_key": "mexc_daily_review",
      "overlay_redis_key": "bot_assessor:mexc_spot:overlays",
      "allow_parameter_overlays": true,
      "allowed_overlay_types": ["score_offset", "strategy_block", "symbol_block", "threshold_adjustment"]
    },
    {
      "id": "mexc_futures",
      "name": "MEXC Futures Bot",
      "github_repo": "romaincortese-ui/futuresbot",
      "railway_service": "Futures-bot",
      "railway_environment": "production",
      "backtest_command": ["python", "run_daily_calibration.py"],
      "backtest_env": {"FUTURES_BACKTEST_ROLLING_DAYS": "30", "BACKTEST_PRINT_FULL_REPORT": "false"},
      "maturity": "mature_high_risk",
      "compatible_review_redis_key": "mexc_futures_daily_review",
      "overlay_redis_key": "bot_assessor:mexc_futures:overlays",
      "allow_parameter_overlays": true,
      "allowed_overlay_types": ["score_offset", "strategy_block", "symbol_block", "threshold_adjustment"]
    },
    {
      "id": "forex",
      "name": "Forex Bot",
      "github_repo": "romaincortese-ui/FX-bot",
      "railway_service": "Forex-Bot",
      "railway_environment": "production",
      "backtest_command": ["python", "run_daily_calibration.py"],
      "backtest_env": {"BACKTEST_ROLLING_DAYS": "30"},
      "maturity": "macro_mature",
      "compatible_review_redis_key": "bot_assessor:forex:daily_review",
      "overlay_redis_key": "bot_assessor:forex:overlays",
      "allow_parameter_overlays": true,
      "allowed_overlay_types": ["score_offset", "strategy_block", "pair_block"]
    },
    {
      "id": "gold",
      "name": "Gold Bot",
      "github_repo": "romaincortese-ui/gold-bot",
      "railway_service": "worker",
      "railway_environment": "production",
      "backtest_command": ["python", "run_daily_calibration.py"],
      "backtest_env": {"GOLD_BACKTEST_ROLLING_DAYS": "30"},
      "maturity": "macro_mature_high_risk",
      "compatible_review_redis_key": "bot_assessor:gold:daily_review",
      "overlay_redis_key": "bot_assessor:gold:overlays",
      "allow_parameter_overlays": true,
      "allowed_overlay_types": ["score_offset", "strategy_block"]
    },
    {
      "id": "commodities",
      "name": "Commodities Bot",
      "github_repo": "romaincortese-ui/commodities_bot",
      "railway_service": "commodities-bot",
      "railway_environment": "production",
      "backtest_command": ["python", "-m", "commoditiesbot.backtest.run_backtest"],
      "backtest_env": {"BACKTEST_DAYS": "30"},
      "maturity": "research",
      "compatible_review_redis_key": "bot_assessor:commodities:daily_review",
      "overlay_redis_key": "bot_assessor:commodities:overlays",
      "allow_parameter_overlays": false,
      "allowed_overlay_types": []
    },
    {
      "id": "bonds",
      "name": "Bonds Bot",
      "github_repo": "romaincortese-ui/bonds_bot",
      "railway_service": "bonds-bot",
      "railway_environment": "production",
      "backtest_command": ["python", "-m", "bondsbot.backtest.run_backtest"],
      "backtest_env": {"BACKTEST_DAYS": "30"},
      "maturity": "research",
      "compatible_review_redis_key": "bot_assessor:bonds:daily_review",
      "overlay_redis_key": "bot_assessor:bonds:overlays",
      "allow_parameter_overlays": false,
      "allowed_overlay_types": []
    }
  ]
}