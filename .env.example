# Required for GitHub issue publishing
BOT_ASSESSOR_GITHUB_REPO=romaincortese-ui/bot-assessor
BOT_ASSESSOR_GITHUB_TOKEN=

# Required for Railway log collection
RAILWAY_TOKEN=

# Optional Redis publishing, use the shared Redis project URL
REDIS_URL=
BOT_ASSESSOR_PUBLISH_COMPAT_REVIEWS=true
BOT_ASSESSOR_APPLY_OVERLAYS=false

# Add these last when you want Telegram notifications
BOT_ASSESSOR_TELEGRAM_TOKEN=
BOT_ASSESSOR_TELEGRAM_CHAT_ID=

# Optional runtime controls
BOT_ASSESSOR_CONFIG=assessor_config.json
BOT_ASSESSOR_WINDOW_HOURS=24
BOT_ASSESSOR_DRY_RUN=false
BOT_ASSESSOR_SKIP_BACKTESTS=false
BOT_ASSESSOR_SKIP_LOGS=false